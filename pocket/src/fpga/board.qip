# The board's RTL: everything wrally_board needs that is not part of the
# Pocket shell. ap_core.qsf pulls it in whole. Keep in step with
# sim/wrally/build.sh, which compiles the same list (with fx68k's
# hdl/verilator/ variant instead).
#
# Paths are relative to this file (pocket/src/fpga), via $::quartus(qip_path),
# so the list works from any project that includes it.
#
# Files read with $readmem relative to the project directory are copied next
# to ap_core.qpf by pocket/build.sh before Quartus runs (all derived, all
# gitignored): fx68k's microrom.mem and nanorom.mem and jt8051's microcode,
# jt8051.uc (tools/gen_jt8051.sh, whose headers are on the search path below).

set q $::quartus(qip_path)
set r [file join $q ../../../rtl]
set t [file join $q ../../../third_party]
set g [file join $q ../../../build/gen]

set_global_assignment -name SYSTEMVERILOG_FILE [file join $r top/wrally_board.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $r mem/wrally_romport.sv]
set_global_assignment -name VERILOG_FILE       [file join $r mem/wrally_vmem.v]
set_global_assignment -name VERILOG_FILE       [file join $r cpu/wrally_main.v]
set_global_assignment -name VERILOG_FILE       [file join $r cpu/wrally_addr_decode.v]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $r cpu/wrally_cpu_clk.sv]
set_global_assignment -name VERILOG_FILE       [file join $r cpu/wrally_vram_decrypt.v]
set_global_assignment -name VERILOG_FILE       [file join $r cpu/wrally_iolatch.v]
set_global_assignment -name VERILOG_FILE       [file join $r io/wrally_inputs.v]
set_global_assignment -name VERILOG_FILE       [file join $r mcu/wrally_mcu.v]
set_global_assignment -name VERILOG_FILE       [file join $r sound/wrally_oki.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_video_top.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_video_timing.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_video.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_tilemap.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_tile_attr.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_sprite_layer.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_sprite_engine.v]
set_global_assignment -name VERILOG_FILE       [file join $r video/wrally_palette.v]

# The DS5002FP: jt8051 (jotego), cycle-accurate, its microcode expanded at
# build time. Its multicycles are in core/core_constraints.sdc.
set_global_assignment -name SEARCH_PATH [file join $g jt8051]
foreach f {jt8051.v jt8051_ctrl.v jt8051_regs.v jt8051_alu.v jt8051_periph.v jt8051_serial.v} {
    set_global_assignment -name VERILOG_FILE [file join $t jtcores/modules/jt8051/hdl $f]
}

# The OKI M6295: jt6295 (jotego) with the two fixes in tools/patches/, which
# tools/bootstrap.sh applies and pocket/build.sh checks are in place.
foreach f {jt6295.v jt6295_acc.v jt6295_adpcm.v jt6295_ctrl.v jt6295_rom.v jt6295_serial.v
           jt6295_sh_rst.v jt6295_timing.v jt12_interpol.v jt12_comb.v} {
    set_global_assignment -name VERILOG_FILE [file join $t jt6295/hdl $f]
}

# jtframe's RAM primitives (the shared RAM, the 8051's internal RAM)
foreach f {jtframe_dual_ram16.v jtframe_dual_ram.v jtframe_ram_rst.v jtframe_ram.v} {
    set_global_assignment -name VERILOG_FILE [file join $t jtcores/modules/jtframe/hdl/ram $f]
}

# fx68k: hdl/ is ijor's synthesis code.
set_global_assignment -name SYSTEMVERILOG_FILE [file join $t fx68k/hdl/fx68k.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $t fx68k/hdl/fx68kAlu.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $t fx68k/hdl/uaddrPla.sv]
